      "CertConfig": {
        "CertMode": "self",
        "RejectUnknownSni": false,
        "CertDomain": "example.com",
        "CertFile": "/etc/ljfxznode/fullchain.cer",
        "KeyFile": "/etc/ljfxznode/cert.key",
        "Provider": "cloudflare",
        "DNSEnv": {
          "EnvName": "env1"
